# Karti environment — copy to .env.local and fill in values.
# Never commit real secrets. See specs/ENVIRONMENT.md.
#
# Classification: NEXT_PUBLIC_* = browser-visible (safe to expose).
# SUPABASE_SERVICE_ROLE_KEY = server-only (guarded by `server-only`).

# Public Supabase project URL (browser-visible, safe to expose).
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anon key (browser-visible, safe to expose; RLS still applies).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service-role key. NEVER prefix with NEXT_PUBLIC_.
# Read only via src/lib/env-server.ts (server code); used by the anonymous
# public-profile / resolver / vCard read paths with projected columns.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical app base URL. Used to build permanent card URLs, QR payloads,
# public profile URLs and vCard links. No trailing slash.
# Production: https://karti.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Digital wallet (ADR-046, all server-only) ---
# Apple Wallet .pkpass signing. Requires an Apple Developer Pass Type ID
# certificate exported as .p12 (base64). Without these, the iOS wallet flow
# degrades to the Copy/Share fallback — never a fake button.
# APPLE_PASS_TYPE_ID=pass.app.karti.card
# APPLE_TEAM_ID=
# APPLE_PASS_CERT_P12_BASE64=
# APPLE_PASS_CERT_PASSPHRASE=
# Apple WWDR intermediate certificate (PEM, download from Apple PKI).
# APPLE_WWDR_CERT_PEM=
#
# Google Wallet save links. Requires a Google Wallet API issuer + service
# account (private key with \n escapes). Without these, the Android flow
# degrades to the Copy/Share fallback.
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_WALLET_PRIVATE_KEY=
