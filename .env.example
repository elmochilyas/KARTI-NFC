# Karti environment — copy to .env.local and fill in values.
# Never commit real secrets. See specs/ENVIRONMENT.md.
#
# Classification: NEXT_PUBLIC_* = browser-visible (safe to expose).
# SUPABASE_SERVICE_ROLE_KEY = server-only (guarded by `server-only`).

# Public Supabase project URL (browser-visible, safe to expose).
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anon key (browser-visible, safe to expose; RLS still applies).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service-role key. NEVER prefix with NEXT_PUBLIC_.
# Read only via src/lib/env-server.ts (server code); used by the anonymous
# public-profile / resolver / vCard read paths with projected columns.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical app base URL. Used to build permanent card URLs, QR payloads,
# public profile URLs and vCard links. No trailing slash.
# Production: https://karti.pro
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Karti sales WhatsApp number (digits only, e.g. 212612345678). Server-only.
# Powers the "Continue on WhatsApp" CTA on the order success page; when
# unset the CTA hides cleanly and ordering still works.
KARTI_SALES_WHATSAPP=

# Receipt-token HMAC secret (min 16 chars, e.g. output of `openssl rand -hex 32`).
# Server-only. Binds public receipt tokens to order idempotency keys so a
# lost-response retry re-derives the SAME valid token. Without it, public
# order creation fails closed. Never expose to the browser or logs.
RECEIPT_TOKEN_SECRET=

# Rate-limit HMAC secret (min 16 chars, e.g. output of `openssl rand -hex 32`).
# Server-only. Derives the non-reversible abuse key
# HMAC(secret, normalized-IP + action) for the durable Postgres rate limiter
# (public Order/Inquiry submission). Never expose to the browser, never store
# alongside rate-limit rows, never use as analytics/user identity.
RATE_LIMIT_SECRET=

# Delivery-Sheet mirror via Apps Script Web App (server-only).
# SOLE configuration source: the dashboard never handles credentials.
# No Google service account, no private keys, no Google Cloud setup: Karti
# POSTs signed envelopes to the bound Apps Script Web App, which writes the
# operator's Sheet. Local is disabled by default (leave ENABLED unset);
# preview stays disabled unless explicitly pointed at a SEPARATE test Apps
# Script deployment/Sheet — never the production delivery Sheet.
# Never prefix with NEXT_PUBLIC_, never commit values.
# Production URL must be the /exec deployment URL, never /dev.
DELIVERY_SHEETS_ENABLED=true
DELIVERY_SHEETS_APPS_SCRIPT_URL=
# https://script.google.com/macros/s/.../exec
# Ingest HMAC secret (min 32 chars, e.g. `openssl rand -hex 32`). Must match
# Apps Script Script Property KARTI_INGEST_SECRET exactly.
DELIVERY_SHEETS_APPS_SCRIPT_SECRET=

# Delivery-Sheet webhook signing secret (min 32 chars, e.g. `openssl rand -hex 32`).
# Server-only. Must match Apps Script Script Property KARTI_WEBHOOK_SECRET;
# never in worksheet cells or client code. HMAC-SHA256 over timestamp + "." + raw body.
# (Renamed from GOOGLE_SHEETS_WEBHOOK_SECRET during the Apps Script refactor;
# the old name is no longer read.)
DELIVERY_SHEETS_WEBHOOK_SECRET=

# Delivery-Sheet retry cron secret (min 16 chars, e.g. `openssl rand -hex 32`).
# Server-only. Single name: Vercel cron sends `Authorization: Bearer
# $CRON_SECRET` automatically, so scheduled retries need zero operator
# wiring. Separate from the admin session.
CRON_SECRET=

# Google Tag Manager container ID (browser-visible, PUBLIC — not a secret).
# Production: GTM-PCXTLTM7. GA4 is configured INSIDE GTM; never add a direct
# gtag.js / G-XXXXXXXXXX script alongside it. When unset, GTM simply does
# not load and the app keeps working (analytics adapter stays a safe no-op).
NEXT_PUBLIC_GTM_ID=
